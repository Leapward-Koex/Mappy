#
import os
import os.path
import json

top = '.'
out = 'build'

PHONE_MODE_PHONE = 'phone'
PHONE_MODE_FIXTURE = 'fixture'
PHONE_MODE_REAL_FIXTURE = 'real-fixture'
SYNTHETIC_FIXTURE_PKJS = '../../tooling/pebble-map-mock-pkjs.js'
REAL_FIXTURE_PKJS = '../../tooling/real-map-fixtures/generated/pebble-map-real-fixture-pkjs.js'
FIXTURE_OPTIONS_GENERATED = 'src/pkjs/fixture-options.generated.js'


def normalize_phone_mode(ctx):
    raw = os.environ.get('MAPPY_WATCH_PHONE_MODE') or os.environ.get('PEBBLE_PHONE_MODE') or PHONE_MODE_PHONE
    value = raw.strip().lower().replace('_', '-')
    if value in ('phone', 'native', 'android', 'production', 'prod'):
        return PHONE_MODE_PHONE
    if value in ('fixture', 'fixtures', 'emulator-fixture', 'emulator-fixtures', 'test-fixture', 'test-fixtures'):
        return PHONE_MODE_FIXTURE
    if value in ('real-fixture', 'real-fixtures', 'real-map-fixture', 'provider-fixture'):
        return PHONE_MODE_REAL_FIXTURE
    ctx.fatal("Unsupported MAPPY_WATCH_PHONE_MODE '{}'. Use 'phone', 'fixture', or 'real-fixture'.".format(raw))


def phone_mode_defines(phone_mode):
    if phone_mode in (PHONE_MODE_FIXTURE, PHONE_MODE_REAL_FIXTURE):
        return ['MAPPY_WATCH_PHONE_MODE_FIXTURE=1']
    return ['MAPPY_WATCH_PHONE_MODE_PHONE=1']


def pkjs_entry_file(phone_mode):
    if phone_mode == PHONE_MODE_FIXTURE:
        return 'src/pkjs/fixture-index.js'
    if phone_mode == PHONE_MODE_REAL_FIXTURE:
        return 'src/pkjs/real-fixture-index.js'
    return 'src/pkjs/index.js'


def js_sources(ctx, phone_mode):
    sources = ctx.path.ant_glob(['src/pkjs/**/*.js',
                                 'src/pkjs/**/*.json',
                                 'src/common/**/*.js'])
    excluded = [
        'src/pkjs/index.js',
        'src/pkjs/fixture-index.js',
        'src/pkjs/real-fixture-index.js',
    ]
    if phone_mode not in (PHONE_MODE_FIXTURE, PHONE_MODE_REAL_FIXTURE):
        excluded.extend([
            'src/pkjs/fixture-options.js',
            FIXTURE_OPTIONS_GENERATED,
        ])
    sources = [source for source in sources if source.path_from(ctx.path) not in excluded]
    entry_file = pkjs_entry_file(phone_mode)
    entry = ctx.path.find_node(entry_file)
    if not entry:
        ctx.fatal("PKJS entrypoint was not found: {}".format(entry_file))
    sources.append(entry)
    if phone_mode in (PHONE_MODE_FIXTURE, PHONE_MODE_REAL_FIXTURE):
        fixture_path = (REAL_FIXTURE_PKJS
                        if phone_mode == PHONE_MODE_REAL_FIXTURE
                        else SYNTHETIC_FIXTURE_PKJS)
        fixture = ctx.path.find_node(fixture_path)
        if not fixture:
            if phone_mode == PHONE_MODE_REAL_FIXTURE:
                ctx.fatal("Real-map fixture PKJS was not found: {}. Generate or restore the local fixture before using real-fixture mode.".format(fixture_path))
            ctx.fatal("Fixture PKJS was not found: {}".format(fixture_path))
        sources.append(fixture)
    return sources


def fixture_int_env(name, default, minimum, maximum):
    raw = os.environ.get(name)
    if raw is None or raw.strip() == '':
        return default
    try:
        value = int(raw, 10)
    except ValueError:
        return default
    return max(minimum, min(maximum, value))


def fixture_bool_env(name, default=False):
    raw = os.environ.get(name)
    if raw is None or raw.strip() == '':
        return default
    return raw.strip().lower() in ('1', 'true', 'yes', 'on')


def write_fixture_options(ctx):
    pkjs_dir = ctx.path.find_node('src/pkjs')
    if not pkjs_dir:
        ctx.fatal("PKJS directory was not found: src/pkjs")
    output_path = os.path.join(pkjs_dir.abspath(), 'fixture-options.generated.js')
    options = {
        'tileDelayMs': fixture_int_env('MAPPY_FIXTURE_TILE_DELAY_MS', 0, 0, 60000),
        'tileStaggerMs': fixture_int_env('MAPPY_FIXTURE_TILE_STAGGER_MS', 0, 0, 60000),
        'tileAnimationMode': fixture_int_env('MAPPY_FIXTURE_TILE_ANIMATION_MODE', -1, -1, 2),
        'tileWidth': fixture_int_env('MAPPY_FIXTURE_TILE_WIDTH', 54, 54, 108),
        'tileHeight': fixture_int_env('MAPPY_FIXTURE_TILE_HEIGHT', 63, 63, 126),
        'tileChunkBytes': fixture_int_env('MAPPY_FIXTURE_TILE_CHUNK_BYTES', 3072, 128, 3072),
        'tileHighEntropy': fixture_bool_env('MAPPY_FIXTURE_TILE_HIGH_ENTROPY'),
        'routePointCount': fixture_int_env('MAPPY_FIXTURE_ROUTE_POINT_COUNT', 3, 3, 128),
        'txSuccessDelayMs': fixture_int_env('MAPPY_FIXTURE_TX_SUCCESS_DELAY_MS', 45, 0, 5000),
        'txFailureDelayMs': fixture_int_env('MAPPY_FIXTURE_TX_FAILURE_DELAY_MS', 180, 0, 5000),
        'phoneReadyDelayMs': fixture_int_env('MAPPY_FIXTURE_PHONE_READY_DELAY_MS', 0, 0, 60000),
        'ignoreStartupReady': fixture_bool_env('MAPPY_FIXTURE_IGNORE_STARTUP_READY'),
        'ignoreFirstInit': fixture_bool_env('MAPPY_FIXTURE_IGNORE_FIRST_INIT'),
        'injectStaleTileFirst': fixture_bool_env('MAPPY_FIXTURE_INJECT_STALE_TILE_FIRST'),
    }
    content = "// Generated by wscript for fixture-mode emulator builds.\n"
    content += "module.exports = {};\n".format(json.dumps(options, sort_keys=True))
    with open(output_path, 'w') as fh:
        fh.write(content)


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    """
    This method is used to configure your build. ctx.load('pebble_sdk') automatically configures
    a build for each valid platform in targetPlatforms.
    """
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')

    phone_mode = normalize_phone_mode(ctx)
    if phone_mode in (PHONE_MODE_FIXTURE, PHONE_MODE_REAL_FIXTURE):
        write_fixture_options(ctx)
    defines = phone_mode_defines(phone_mode)
    hardware_perf = os.environ.get('MAPPY_WATCH_HARDWARE_PERF', '').strip().lower()
    if phone_mode == PHONE_MODE_PHONE and hardware_perf in ('1', 'true', 'yes', 'on'):
        defines.append('MAPPY_WATCH_HARDWARE_PERF=1')
    build_worker = os.path.exists('worker_src')
    binaries = []

    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        # LTO otherwise drops the generated, unreferenced Pebble process header.
        ctx.env.append_value('LINKFLAGS', ['-flto', '-Wl,-u,__pbl_app_info'])
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'),
                      target=app_elf,
                      bin_type='app',
                      defines=defines,
                      cflags=['-flto'])

        if build_worker:
            worker_elf = '{}/pebble-worker.elf'.format(ctx.env.BUILD_DIR)
            binaries.append({'platform': platform, 'app_elf': app_elf, 'worker_elf': worker_elf})
            ctx.pbl_build(source=ctx.path.ant_glob('worker_src/c/**/*.c'),
                          target=worker_elf,
                          bin_type='worker',
                          defines=defines,
                          cflags=['-flto'])
        else:
            binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=js_sources(ctx, phone_mode),
                   js_entry_file=pkjs_entry_file(phone_mode))
